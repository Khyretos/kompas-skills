# Root, but no capabilities: reads drm-* lines of /proc/*/fdinfo of root-owned
# processes (same-uid check) and serves aggregates on a unix socket for the
# group "kompanion-gpu". Install: see install.sh.
[Unit]
Description=Kompanion GPU helper (per-engine GPU stats, read-only)
After=local-fs.target

[Service]
ExecStart=/usr/local/bin/kompanion-gpu-helper /run/kompanion-gpu/stats.sock
User=root
Group=kompanion-gpu
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
RuntimeDirectory=kompanion-gpu
RuntimeDirectoryMode=0750
UMask=0007
Restart=on-failure

[Install]
WantedBy=multi-user.target
