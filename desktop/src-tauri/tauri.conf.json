{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kreative Kompanion",
  "version": "0.1.0",
  "identifier": "com.kreative-kompas.kompanion",
  "build": { "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kreative Kompanion",
        "url": "https://kompanion.kreative-kompas.com/",
        "width": 1280,
        "height": 860,
        "minWidth": 380,
        "minHeight": 500
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "category": "Productivity",
    "shortDescription": "Kreative Kompanion",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
